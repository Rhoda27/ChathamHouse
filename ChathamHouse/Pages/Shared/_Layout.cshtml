<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChathamHouse</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ChathamHouse.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/fontawesome-free-7.1.0-web/css/all.css" />
    <script src="https://webrtchacks.github.io/adapter/adapter-latest.js"></script>
    <script src="https://cdn.red5pro.com/release/14.2.0/red5pro-sdk.min.js"></script>
</head>
<body>

    <div class="container-fluid">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <div id="ratingModalContainer">
        @await Html.PartialAsync("_RatingModal")
    </div>

    @Html.AntiForgeryToken()

    <!-- IMPORTANT: jQuery MUST load BEFORE Bootstrap -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/fontawesome-free-7.1.0-web/js/all.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>