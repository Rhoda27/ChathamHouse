@page
@model ChathamHouse.Pages.Land.IndexModel
@{
    ViewData["Title"] = "My Dashboard";

    string GetTimeAgo(DateTime dateTime)
    {
        var ts = DateTime.Now - dateTime;
        return ts.TotalMinutes < 1 ? "just now" :
               ts.TotalMinutes < 60 ? $"posted {ts.Minutes} min ago" :
               ts.TotalHours < 24 ? $"posted {ts.Hours} hour{(ts.Hours > 1 ? "s" : "")} ago" :
               ts.TotalDays < 7 ? $"posted {ts.Days} day{(ts.Days > 1 ? "s" : "")} ago" :
               $"posted {ts.Days / 7} week{(ts.Days / 7 > 1 ? "s" : "")} ago";
    }
}

